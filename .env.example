# --- Supabase (obligatorias) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca con prefijo NEXT_PUBLIC_. En Vercel marcala como Sensitive.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cvs

# --- Feature flags ---
# Dejar en false hasta validar el flujo completo de carga y descarga de CV.
ENABLE_CV_UPLOAD=false
ENABLE_MATCHING=false
# El envío de email todavía es un stub: no manda nada.
ENABLE_AUTO_EMAIL=false
MATCHING_THRESHOLD=70

# --- CAPTCHA (Cloudflare Turnstile) ---
# Con ENABLE_CAPTCHA=false el widget no se renderiza y el server no exige token.
# Para activarlo hacen falta las dos claves: dash.cloudflare.com > Turnstile.
ENABLE_CAPTCHA=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email (sin uso todavía: no hay código que lea estas variables) ---
EMAIL_PROVIDER=resend
RESEND_API_KEY=
BREVO_API_KEY=
