# --- Supabase (obligatorias) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca con prefijo NEXT_PUBLIC_. En Vercel marcala como Sensitive.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cvs

# --- Feature flags ---
# Dejar en false hasta validar el flujo completo de carga y descarga de CV.
ENABLE_CV_UPLOAD=false
ENABLE_MATCHING=false
# El envío de email todavía es un stub: no manda nada.
ENABLE_AUTO_EMAIL=false
MATCHING_THRESHOLD=70

# --- CAPTCHA (Cloudflare Turnstile) ---
# Con ENABLE_CAPTCHA=false el widget no se renderiza y el server no exige token.
# Para activarlo hacen falta las dos claves: dash.cloudflare.com > Turnstile.
ENABLE_CAPTCHA=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Email del formulario de contacto (Resend) ---
# Sin RESEND_API_KEY el formulario responde 503 con un mensaje claro en vez de
# fingir que la consulta se envió. Es a propósito: un "gracias" falso pierde el
# contacto y nadie se entera.
#
# Plan gratuito: 3.000 envíos/mes, 100/día. Alcanza de sobra.
#
# Cómo obtenerla:
#   1. Crear la cuenta en resend.com CON rrhhworking17@gmail.com.
#      Importante: sin un dominio propio verificado, Resend sólo deja enviar a
#      la casilla dueña de la cuenta. Como el formulario siempre escribe a esa
#      misma dirección, funciona sin dominio.
#   2. API Keys > Create API Key (permiso de sólo envío) y pegarla acá.
#   3. En Vercel, cargarla como variable de entorno marcada Sensitive.
RESEND_API_KEY=

# Remitente. Sin dominio propio hay que dejar el de Resend.
# Con dominio verificado, cambiarlo por algo como "RRHH Working <hola@tudominio.com>".
RESEND_FROM=RRHH Working <onboarding@resend.dev>

# Destino de las consultas. Si se omite, usa CONTACT.email de institucional.ts.
CONTACT_TO_EMAIL=

EMAIL_PROVIDER=resend
BREVO_API_KEY=
